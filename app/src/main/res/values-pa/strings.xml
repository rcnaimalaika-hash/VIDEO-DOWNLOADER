    <!-- FAQ Items -->
    <string name="faq_q1">ਮੈਂ ਵੀਡੀਓ ਕਿਵੇਂ ਡਾਊਨਲੋਡ ਕਰਾਂ?</string>
    <string name="faq_a1">1. ਵੀਡੀਓ ਲਿੰਕ ਕਾਪੀ ਕਰੋ।\n2. ਐਪ ਵਿੱਚ ਸਰਚ ਬਾਕਸ ਵਿੱਚ ਲਿੰਕ ਪੇਸਟ ਕਰੋ।\n3. \'ਡਾਊਨਲੋਡ\' ਬਟਨ ਦਬਾਓ ਅਤੇ ਫਾਰਮੈਟ ਚੁਣੋ।</string>
    <string name="faq_q2">ਮੇਰੇ ਡਾਊਨਲੋਡ ਕਿੱਥੇ ਲੱਭਣਗੇ?</string>
    <string name="faq_a2">ਸਾਰੀਆਂ ਫ਼ਾਈਲਾਂ ਐਪ ਦੇ \'ਡਾਊਨਲੋਡ\' ਟੈਬ ਵਿੱਚ ਅਤੇ ਫ਼ੋਨ ਮੈਮੋਰੀ ਵਿੱਚ ਮਿਲਣਗੀਆਂ।</string>
    <string name="faq_q3">HD ਗੁਣਵੱਤਾ ਵਿੱਚ ਕਿਵੇਂ ਡਾਊਨਲੋਡ ਕਰਨਾ ਹੈ?</string>
    <string name="faq_a3">ਫਾਰਮੈਟ ਸੂਚੀ ਵਿੱਚੋਂ 1080p ਜਾਂ 4K ਵਿਕਲਪ ਚੁਣੋ।</string>
    <string name="faq_q4">ਡਾਊਨਲੋਡ ਰੁਕ ਕਿਉਂ ਗਿਆ?</string>
    <string name="faq_a4">ਦੁਬਾਰਾ ਕੋਸ਼ਿਸ਼ ਕਰੋ ਬਟਨ ਦਬਾਓ।</string>
    <string name="faq_q5">ਕੀ ਮੇਰਾ ਡਾਟਾ ਸੁਰੱਖਿਅਤ ਹੈ?</string>
    <string name="faq_a5">ਹਾਂ, 100% ਸੁਰੱਖਿਅਤ ਹੈ। ਅਸੀਂ ਕੋਈ ਨਿੱਜੀ ਜਾਣਕਾਰੀ ਇਕੱਠੀ ਨਹੀਂ ਕਰਦੇ।</string>

