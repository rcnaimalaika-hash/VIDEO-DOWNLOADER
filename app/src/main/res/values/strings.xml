    <!-- FAQ Items -->
    <string name="faq_q1">How do I download a video?</string>
    <string name="faq_a1">1. Copy the video link from any social or video platform.\n2. Open Video Downloader and paste the URL into the search box on the Home screen.\n3. Tap \'Download\', select your desired format (Video or Audio) and quality, and the download will start instantly.</string>
    <string name="faq_q2">Where can I find my downloads?</string>
    <string name="faq_a2">All finished downloads are listed in the \'Downloads\' tab inside the app. You can also find files directly in your phone\'s storage under \'Download/VideoDownloader\'.</string>
    <string name="faq_q3">How to download in HD quality?</string>
    <string name="faq_a3">When the format selection bottom sheet opens, select high resolution options like 1080p, 2K, or 4K if available on the source video.</string>
    <string name="faq_q4">Why did my download pause or fail?</string>
    <string name="faq_a4">Downloads can pause due to unstable internet connections or temporary source server limits. Tap the retry button next to any failed item to resume automatically.</string>
    <string name="faq_q5">Is my personal data safe?</string>
    <string name="faq_a5">Yes, 100%. We do not store or track your personal browsing history or downloaded files on external servers. All operations are processed safely on your device.</string>

    <!-- Privacy Policy Screen -->
    <string name="privacy_title">Privacy Policy</string>
    <string name="privacy_header_title">Your privacy is our priority</string>
    <string name="privacy_header_subtitle">We are committed to protecting your privacy and ensuring a safe experience while using our app. This Privacy Policy explains how we collect, use and protect your information.</string>
    <string name="privacy_contact_title">Contact Us</string>
    <string name="privacy_contact_desc">If you have any questions about this Privacy Policy, please contact us at support@videodownloader.com</string>
    <string name="privacy_last_updated">Last updated: May 20, 2024</string>

    <string name="privacy_sec1_title">1. Information We Collect</string>
    <string name="privacy_sec1_desc">We do not collect any personally identifiable information (PII) such as your name, phone number, or contacts. We only process URLs you explicitly provide to fetch public media metadata.</string>
    <string name="privacy_sec2_title">2. How We Use Information</string>
    <string name="privacy_sec2_desc">The information processed is strictly utilized to facilitate fast video/audio downloads, improve app stability, and present helpful user analytics on your local device.</string>
    <string name="privacy_sec3_title">3. Data Security</string>
    <string name="privacy_sec3_desc">All network communications use secure TLS/SSL encryption. We do not store your downloads on our servers; media is saved directly to your device storage.</string>
    <string name="privacy_sec4_title">4. Third-Party Services</string>
    <string name="privacy_sec4_desc">The app may interact with third-party content providers to retrieve media files requested by you. These services have their own independent privacy policies.</string>
    <string name="privacy_sec5_title">5. Your Choices &amp; Control</string>
    <string name="privacy_sec5_desc">You have full control over your download history, cache, and app preferences. You can clear cache and remove downloaded media at any time through the app settings.</string>
    <string name="privacy_sec6_title">6. Changes to This Policy</string>
    <string name="privacy_sec6_desc">We may update our Privacy Policy periodically to reflect app upgrades. Any updates will be posted here with a revised last updated date.</string>

